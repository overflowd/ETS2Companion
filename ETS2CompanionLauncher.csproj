<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ETS2CompanionLauncher</AssemblyName>
    <RootNamespace>ETS2CompanionLauncher</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <Product>ETS 2 Companion Launcher</Product>
    <Description>Automatically launches companion apps (Lossless Scaling, LookPilot, WestPlay, and custom tools) when Euro Truck Simulator 2 starts.</Description>
  </PropertyGroup>

</Project>
