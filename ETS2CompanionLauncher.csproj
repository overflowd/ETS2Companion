<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ETS2CompanionLauncher</AssemblyName>
    <RootNamespace>ETS2CompanionLauncher</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <Product>ETS 2 Otomatik Uygulama Başlatıcı</Product>
    <Description>ETS 2 açıldığında Lossless Scaling, LookPilot ve WestPlay uygulamalarını otomatik başlatır.</Description>
  </PropertyGroup>

</Project>
