<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ETS2CompanionLauncher</AssemblyName>
    <RootNamespace>ETS2CompanionLauncher</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.3</Version>
    <Product>ETS 2 Companion Launcher</Product>
    <Description>Lightweight Windows tray utility that automatically launches your chosen companion apps when Euro Truck Simulator 2 or American Truck Simulator starts.</Description>
  </PropertyGroup>

</Project>
